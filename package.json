{
  "name": "rlm-runtime",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:standalone": "node scripts/check-standalone.mjs",
    "typecheck:host": "tsc -p plugin/tsconfig.host.json --noEmit",
    "typecheck:runner": "deno check --unstable-worker-options plugin/rlm-runner/runner.ts plugin/rlm-runner/generated-worker.ts",
    "typecheck": "npm run typecheck:host && npm run typecheck:runner",
    "test:host-runtime": "node --test plugin/tests-host/*.test.mjs",
    "test:plugin": "deno test --unstable-worker-options --allow-run --allow-read --allow-write --allow-sys=homedir --allow-env=HOME,XDG_CONFIG_HOME,RLM_CONTEXT_ROOT,RLM_CONTEXT_POLICY,OPENCODE_RLM_CONTEXT_ROOT,OPENCODE_RLM_CONTEXT_POLICY,RLM_TEST_TURN_WALL_MS,RLM_TEST_TURN_EXECS,RLM_TEST_TURN_CTX_CALLS,RLM_TEST_TURN_CTX_CHARS,RLM_TEST_EXEC_TIMEOUT_MS plugin/tests/*.test.ts",
    "test:benchmarks": "node --test benchmarks/harness/*.test.mjs",
    "verify:benchmarks": "node benchmarks/generator/verify.mjs && node benchmarks/generator/verify-v2.mjs && node benchmarks/generator/verify-v3.mjs",
    "verify:resource-envelope": "node scripts/verify-resource-envelope.mjs",
    "test": "npm run check:standalone && npm run test:host-runtime && npm run typecheck && npm run test:plugin && npm run test:benchmarks && npm run verify:benchmarks && npm run check:codex-dist && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "build:codex": "node scripts/build-codex.mjs",
    "check:codex-dist": "node scripts/check-codex-dist.mjs",
    "test:opencode-live": "node scripts/live-opencode-smoke.mjs",
    "test:opencode-structured-live": "node scripts/live-structured-smoke.mjs",
    "test:opencode-verify-live": "node scripts/live-structured-verify-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Sandboxed Recursive Language Model runtime with OpenCode and Codex adapters, bounded context, and isolated child models.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arttvad9r/RLM.git"
  },
  "homepage": "https://github.com/arttvad9r/RLM#readme",
  "bugs": {
    "url": "https://github.com/arttvad9r/RLM/issues"
  },
  "keywords": [
    "opencode",
    "codex",
    "rlm",
    "recursive-language-model",
    "ai-agents",
    "sandbox",
    "typescript",
    "deno"
  ],
  "exports": "./plugin/rlm.ts",
  "files": [
    "plugin/rlm.ts",
    "plugin/rlm-lib/",
    "plugin/rlm-runner/",
    "dist/",
    "agent/",
    "docs/known-limitations.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "bin": {
    "rlm-codex": "./dist/adapters/codex/mcp.js"
  }
}
