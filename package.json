{
  "name": "opencode-rlm",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:standalone": "node scripts/check-standalone.mjs",
    "typecheck:host": "tsc -p plugin/tsconfig.host.json --noEmit",
    "typecheck:runner": "deno check --unstable-worker-options plugin/rlm-runner/runner.ts plugin/rlm-runner/generated-worker.ts",
    "typecheck": "npm run typecheck:host && npm run typecheck:runner",
    "test:host-runtime": "node --test plugin/tests-host/*.test.mjs",
    "test:plugin": "deno test --unstable-worker-options --allow-run --allow-read --allow-write --allow-sys=homedir --allow-env=HOME,XDG_CONFIG_HOME,OPENCODE_RLM_CONTEXT_ROOT,OPENCODE_RLM_CONTEXT_POLICY,RLM_TEST_TURN_WALL_MS,RLM_TEST_TURN_EXECS,RLM_TEST_TURN_CTX_CALLS,RLM_TEST_TURN_CTX_CHARS,RLM_TEST_EXEC_TIMEOUT_MS plugin/tests/*.test.ts",
    "test:benchmarks": "node --test benchmarks/harness/*.test.mjs",
    "verify:benchmarks": "node benchmarks/generator/verify.mjs && node benchmarks/generator/verify-v2.mjs && node benchmarks/generator/verify-v3.mjs",
    "verify:resource-envelope": "node scripts/verify-resource-envelope.mjs",
    "test": "npm run check:standalone && npm run test:host-runtime && npm run typecheck && npm run test:plugin && npm run test:benchmarks && npm run verify:benchmarks && npm run check:package",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Sandboxed Recursive Language Model runtime for OpenCode with bounded context and isolated child agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arttvad9r/RLM.git"
  },
  "homepage": "https://github.com/arttvad9r/RLM#readme",
  "bugs": {
    "url": "https://github.com/arttvad9r/RLM/issues"
  },
  "keywords": [
    "opencode",
    "rlm",
    "recursive-language-model",
    "ai-agents",
    "sandbox",
    "typescript",
    "deno"
  ],
  "exports": "./plugin/rlm.ts",
  "files": [
    "plugin/rlm.ts",
    "plugin/rlm-lib/",
    "plugin/rlm-runner/",
    "agent/",
    "docs/known-limitations.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29"
  }
}
